# Build output
[Bb]in/
[Oo]bj/

# NuGet pack output
*.nupkg
*.snupkg
artifacts/

# Build logs
*.binlog

# IDEs
.vs/
.idea/
.vscode/
*.user
*.suo
*.rsuser

# OS
.DS_Store
._*
Thumbs.db
[Dd]esktop.ini

# Umbraco test site runtime state. The site under test/ is a harness, not a
# deliverable: its database, logs, media and local secrets are disposable.
test/**/umbraco/Data/
test/**/umbraco/Logs/
test/**/wwwroot/media/
test/**/appsettings.Local.json
# Templates created in the test site's backoffice belong to document types that
# only exist in the local, gitignored database.
test/**/Views/

# Umbraco-generated JSON schema files
appsettings-schema.json
appsettings-schema.*.json
umbraco-package-schema.json
