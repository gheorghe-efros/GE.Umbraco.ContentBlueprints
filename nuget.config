<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Local dev builds of this package, produced by scripts/pack-local.sh. Gitignored. -->
    <add key="local" value="artifacts/local-feed" />
  </packageSources>

  <!--
    Source mapping pins this package to the local feed, so the test site can never
    accidentally resolve a published copy from nuget.org instead of the code in this
    repo. Everything else comes from nuget.org as usual.
  -->
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="GE.Umbraco.ContentBlueprints" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
